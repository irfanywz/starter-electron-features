{
  "name": "starter-minimal",
  "productName": "Starter Minimal",
  "version": "0.1.0",
  "description": "Minimal Electron starter: tray, theme, router, toast, logging, portable unpacked build with data beside the exe",
  "main": "./out/main/index.js",
  "author": {
    "name": "Nama Perusahaan",
    "email": ""
  },
  "private": true,
  "scripts": {
    "init": "node scripts/init.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:check": "npm run typecheck && npm run build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist:win": "npm run build && electron-builder --win && node scripts/zip.mjs win",
    "dist:linux": "npm run build && electron-builder --linux && node scripts/zip.mjs linux",
    "release": "npm run dist:win"
  },
  "dependencies": {
    "electron-log": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "archiver": "^7.0.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.30.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "zustand": "^5.0.0"
  }
}
